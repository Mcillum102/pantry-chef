EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 两台手机共用的厨房账号邮箱（在 Supabase 后台手动创建）。
# 密码就是「厨房口令」，不要写在这里：每台手机第一次打开时输入一次。
EXPO_PUBLIC_KITCHEN_EMAIL=our-kitchen@example.com
# 选人页显示的名字（可选，不填用代码里的默认值）
EXPO_PUBLIC_MEMBER_A_NAME=丁丁
EXPO_PUBLIC_MEMBER_B_NAME=小林
OPENAI_API_KEY=your-openai-api-key
