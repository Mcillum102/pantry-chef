EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 两台手机共用的厨房账号（在 Supabase 后台手动创建），app 启动时自动登录
EXPO_PUBLIC_KITCHEN_EMAIL=our-kitchen@example.com
EXPO_PUBLIC_KITCHEN_PASSWORD=a-long-random-password
# 选人页显示的名字（可选，不填用代码里的默认值）
EXPO_PUBLIC_MEMBER_A_NAME=Shuhan
EXPO_PUBLIC_MEMBER_B_NAME=宝贝
OPENAI_API_KEY=your-openai-api-key
