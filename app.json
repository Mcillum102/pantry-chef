{
  "expo": {
    "name": "鲜食记",
    "slug": "pantry-chef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "pantrychef",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CFBundleLocalizations": [
          "zh",
          "en"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E3F0E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon-app.png",
      "name": "鲜食记 · Fresh Pantry",
      "shortName": "鲜食记",
      "lang": "zh-CN",
      "description": "家庭共享的库存、菜谱、饮食与保质期管理工具",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "portrait-primary",
      "themeColor": "#2F6B4F",
      "backgroundColor": "#F7F5EF",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/images/logo-concept-v1.png",
          "imageWidth": 152,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "zh",
              "en"
            ],
            "android": [
              "zh",
              "en"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "允许鲜食记使用相机扫描商品条形码"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许鲜食记选择菜谱或购物小票图片进行识图分析",
          "cameraPermission": "允许鲜食记拍摄菜谱或购物小票进行识图分析"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2fe97c01-c303-4927-93f1-008ba7f98489"
      }
    }
  }
}
